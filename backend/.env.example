# ComfyUI API endpoint. For Docker Desktop reaching a host process, use host.docker.internal.
COMFYUI_URL=http://host.docker.internal:8189
# Export from ComfyUI using "Save (API Format)" and mount/copy this JSON into the API container.
COMFYUI_WORKFLOW_PATH=/app/workflows/wan22_ti2v_5b_api.json
# Configure IDs and input keys to match your exported workflow.
COMFYUI_PROMPT_NODE_ID=
COMFYUI_PROMPT_INPUT=text
COMFYUI_IMAGE_NODE_ID=
COMFYUI_IMAGE_INPUT=image
COMFYUI_REQUEST_TIMEOUT=60

MAX_UPLOAD_MB=100
CORS_ORIGINS=http://localhost:3000
UPLOAD_DIR=/app/data/uploads
# Never commit secrets.

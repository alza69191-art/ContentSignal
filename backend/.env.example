# ComfyUI server. The API container must be able to reach this address.
COMFYUI_URL=http://host.docker.internal:8189
# Browser-facing ComfyUI address used for previewing the generated video.
COMFYUI_PUBLIC_URL=http://localhost:8189
# Ready-to-use API workflow committed in this repository.
COMFYUI_WORKFLOW_PATH=/app/workflows/wan22_ti2v_5b_gguf_api.json
# Node IDs/inputs in the bundled workflow (change only if you replace the workflow).
COMFYUI_PROMPT_NODE_ID=6
COMFYUI_PROMPT_INPUT=text
COMFYUI_IMAGE_NODE_ID=56
COMFYUI_IMAGE_INPUT=image
COMFYUI_LATENT_NODE_ID=55
COMFYUI_REQUEST_TIMEOUT=60

MAX_UPLOAD_MB=100
CORS_ORIGINS=http://localhost:3000
UPLOAD_DIR=/app/data/uploads
# Never commit secrets.

# Optional text/script generation providers. Add keys in your private deployment only.
# Gemini: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Groq: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# OpenRouter: https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
OPENROUTER_SITE_URL=https://contentsignal.app
